# Copy to .env and fill in. .env is git-ignored - never commit real keys.

# --- Embeddings ---
# "local"  : free, runs on this machine (Chroma's default MiniLM model), no key needed
# "openai" : any OpenAI-compatible endpoint (uses the two OPENAI_* values below)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small

# --- LLM / OpenAI-compatible endpoint (used for generation, and for embeddings if provider=openai) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini

# --- Vector store & chunking (defaults shown) ---
CHROMA_DIR=chroma_db
CHROMA_COLLECTION=knowledge_base
CHUNK_SIZE=500
CHUNK_OVERLAP=60

# --- Semantic search ---
TOP_K=4
# Minimum cosine similarity (0-1) for a chunk to count as relevant. Calibrated for the local model.
MIN_SCORE=0.30
